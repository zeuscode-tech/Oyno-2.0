SECRET_KEY=your-django-secret-key-here
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Database
DB_NAME=oyno_db
DB_USER=oyno_user
DB_PASSWORD=oyno_pass
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=30

# SMS (для OTP — пример через Eskiz или любой SMS-провайдер KG)
SMS_API_URL=https://notify.eskiz.uz/api/message/sms/send
SMS_EMAIL=your@email.com
SMS_PASSWORD=your-sms-password
SMS_SENDER=4546

# Firebase (FCM)
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# Mbank / O!Dengi (платёжные шлюзы)
MBANK_API_URL=https://api.mbank.kg/v1
MBANK_MERCHANT_ID=your-merchant-id
MBANK_SECRET_KEY=your-secret-key

ODENGI_API_URL=https://api.odengi.kg/v1
ODENGI_MERCHANT_ID=your-merchant-id
ODENGI_SECRET_KEY=your-secret-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000
